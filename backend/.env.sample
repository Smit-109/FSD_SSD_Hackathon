# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/elibrary_system
DATABASE_NAME=elibrary_system

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-complex

# Session Configuration
SESSION_SECRET=elibrary-secret-key-2024-secure-session

# Email Configuration (Optional - for email verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=demo@library.com
EMAIL_PASS=demo-password

# ImageKit Configuration
IMAGEKIT_PUBLIC_KEY=demo_public_key
IMAGEKIT_PRIVATE_KEY=demo_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/demo

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:5173