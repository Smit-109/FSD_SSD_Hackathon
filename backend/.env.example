# Database Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=elibrary_system

# Server Configuration
PORT=5000
NODE_ENV=development

# Session Configuration
SESSION_SECRET=elibrary-secret-key-2024-super-secure-random-string

# JWT Configuration (for API authentication)
JWT_SECRET=jwt-secret-key-2024-super-secure-random-string

# Email Configuration (Optional - for email features)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,epub,mobi,txt
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp

# ImageKit Configuration (Optional - for cloud image storage)
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=your-imagekit-url-endpoint

# Pagination
DEFAULT_PAGE_SIZE=12
MAX_PAGE_SIZE=50

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100