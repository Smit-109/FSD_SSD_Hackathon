<%- include('./partials/header', { title: 'Error - Digital Library', user: user }) %>

<div class="container container-custom">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card card-custom text-center">
                <div class="card-body py-5">
                    <i class="fas fa-exclamation-triangle fa-4x text-warning mb-4"></i>
                    
                    <h2 class="card-title text-danger mb-3">
                        Oops! Something went wrong
                    </h2>
                    
                    <div class="alert alert-danger" role="alert">
                        <i class="fas fa-info-circle me-2"></i>
                        <%= error || 'An unexpected error occurred' %>
                    </div>
                    
                    <p class="text-muted mb-4">
                        We're sorry for the inconvenience. This error has been logged and 
                        our team will investigate the issue.
                    </p>
                    
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        <a href="/" class="btn btn-primary-custom btn-custom">
                            <i class="fas fa-home me-2"></i>Go Home
                        </a>
                        
                        <button onclick="history.back()" class="btn btn-outline-secondary btn-custom">
                            <i class="fas fa-arrow-left me-2"></i>Go Back
                        </button>
                        
                        <button onclick="location.reload()" class="btn btn-outline-info btn-custom">
                            <i class="fas fa-refresh me-2"></i>Try Again
                        </button>
                    </div>
                    
                    <hr class="my-4">
                    
                    <p class="mb-0">
                        <small class="text-muted">
                            If you continue to experience issues, please contact our 
                            <a href="mailto:support@digitallibrary.com" class="text-decoration-none">
                                support team
                            </a>
                        </small>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>